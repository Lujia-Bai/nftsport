  grid <- (1:N)/N  
  t = (1:n)/n
  u = (1:N)/N
  m = (1+u)%o%(10*(t-0.5)^2 + 1) 
  
  X = array(0, c(n + burn_in, N, p))
  E = array(0, c(n + burn_in, N, p))
  for(i in 1:p){
    if(rbinom(1,1,0.5))
      G <- fgarch11(n + burn_in, N, alpha3) # J * N 
    else 
      G <- fgarch11(n + burn_in, N, alpha4)  # J * N 
    
    E[,,i] = t(G)
  }
  
  
  X = E
  
  
  func <- function(t, s) {
    exp(-((t^2 + s^2)/2))
  }
  phi_c_t_s <- function(t, s, c = abs_c) {
    c * exp(-((t^2 + s^2)/2))
  }
  
  if(abs(delta) > 1e-8){
    sum1 <- 0
    for (t in grid) {
      for (s in grid) {
        sum1 <- sum1 + (func(t, s)^2)
      }
    }
    phi_norm_w_out_c <- sqrt(sum1/(N^2))
    abs_c <- delta/phi_norm_w_out_c
    
    #   A = Matrix::bandSparse(p, k = c(-2,-1,0,1,2), diag = list(rep(delta^3,p-2), rep(delta^2,p-1), rep(delta,p), rep(delta^2, p-1), rep(delta^3,p-2))) %>% matrix(nrow = p) 
    
    for(i in 2:n){
      for(j in 1:N){
        far_mat =  X[i-1, ,]
        X[i,j,] = t(t(phi_c_t_s(grid[j], grid, abs_c)/N) %*% far_mat *(1 +0.25* cos(pi*i/n/2))) + E[i,j,]
      }
    }
  }
  
  for(i in 1:p)
    X[(burn_in+1): (burn_in + n),,i] = t(m + t(X[(burn_in+1): (burn_in + n),,i]))
  # output: matrix N*n 
  return(list(X = X[(burn_in+1): (burn_in + n),,],  E = E[(burn_in+1): (burn_in + n),,]))
}
