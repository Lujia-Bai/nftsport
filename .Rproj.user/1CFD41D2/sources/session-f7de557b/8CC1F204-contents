fts.ind<- function(n = 500, N = 200, p = 3, delta = 0){
  # mean function
  t = (1:n)/n
  u = (1:N)/N
  m = (1+u)%o%(10*sin(pi*(t-0.5)) + 1) 
  
  # innovation function
  a = 0.1*(u-0.5)^2+0.8
  X = array(0, c(n,N,p))
  E = array(0, c(n,N,p))
  rand = matrix(rnorm(n*p), ncol = p)
  
  for(i in 1:p){ 
    G = a %o% rand[,i]
    E[,,i] = t(G)
  }
  if(abs(delta) > 1e-8){
    A = Matrix::bandSparse(p, k = c(-1,0,1), diag = list(rep(0.1,p-1), rep(delta,p), rep(0.1, p-1))) %>% matrix(nrow = p) 
    for(i in 2:n){
      for(j in 1:N)
        X[i,j,] = X[i-1,j,] %*%  A * 6 * (j/N-0.5)^2 * sin(pi*i/n/2) + E[i,j,]
    }
  }else{
    X = E
  }
  for(i in 1:p)
    X[,,i] = t(m + t(X[,,i]))
  # output: matrix N*n 
  return(list(X = X,  E = E))
}


fts.nonh2<- function(n = 500, N = 200, p = 3, delta = 0){
  # mean function
  t = (1:n)/n
  u = (1:N)/N
  m = (1+u)%o%(10*(t-0.5)^2 + 1) 
  
  # innovation function
  a1 = 0.5*cos(pi*u/3)+0.2
  a2 = 0.4*u
  tw = 0.8+0.2*sin(pi*t/2)
  # a1 = 0.1*cos(pi*u/3)+0.5
  # a2 = 0.4*u
  # tw = 0.5+0.5*sin(pi*t)
  X = array(0, c(n,N,p))
  E = array(0, c(n,N,p))
  for(i in 1:p){
    
    if(rbinom(1,1,0.5))
      G = a1 %o% (rnorm(n)*tw)
    else 
      G = a2 %o% (rnorm(n)*tw)
    E[,,i] = t(G)
  }
  if(abs(delta) > 1e-8){
    if(p >= 3){
      A = Matrix::bandSparse(p, k = c(-1,0,1), diag = list(rep(0.1,p-1), rep(delta,p), rep(0.1, p-1))) %>% matrix(nrow = p) 
      for(i in 2:n){
        for(j in 1:N)
          X[i,j,] = X[i-1,j,] %*%  A * 6 * (j/N-0.5)^2 * sin(pi*i/n/2) + E[i,j,]
      }
    }else{
      for(i in 2:n){
        for(j in 1:N)
          X[i,j,] = X[i-1,j,] *  delta * 6 * (j/N-0.5)^2 * sin(pi*i/n/2) + E[i,j,]
      }
    }
    
  }else{
    X = E
  }
  for(i in 1:p)
    X[,,i] = t(m + t(X[,,i]))
  # output: matrix N*n 
  return(list(X = X,  E = E))
}

